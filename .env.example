# Copy to .env (optional). Defaults are fine for local docker compose use.
# Used when running the CLI on your host (outside Docker):
KAFKA_BOOTSTRAP=localhost:19092
POSTGRES_DSN=postgresql://streamguard:streamguard@localhost:5432/streamguard

# Processing
SG_WINDOW_SECONDS=10
SG_ALLOWED_LATENESS_S=5
SG_EWMA_ALPHA=0.05
SG_Z_THRESHOLD=4.0
SG_WARMUP=30
SG_ROLLING_WINDOW=60

# Alerts (Slack-compatible incoming webhook; leave empty to only log alerts)
SG_ALERT_WEBHOOK_URL=
SG_ALERT_COOLDOWN_S=60

# Live feed (US users may need wss://stream.binance.us:9443)
BINANCE_WS_BASE=wss://stream.binance.com:9443

# Streamlit dashboard (when running `streamlit run dashboard/app.py` on your host)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Custom links (docker compose reads this file automatically if you copy it to .env)
#
# Local, no setup: browsers resolve *.localhost to your own machine.
#   STREAMGUARD_ADDR=http://streamguard.localhost
#   GRAFANA_ADDR=http://grafana.localhost
#   GRAFANA_URL=http://grafana.localhost          # what the browser opens (embed tab + Grafana links)
# If port 80 is already in use on your PC, add PROXY_HTTP_PORT=8080 and open
#   http://streamguard.localhost:8080  and set GRAFANA_URL=http://grafana.localhost:8080
#
# Your own domain on a server with ports 80/443 open (HTTPS certificates are automatic):
#   STREAMGUARD_ADDR=dashboard.example.com
#   GRAFANA_ADDR=grafana.example.com
#   GRAFANA_URL=https://grafana.example.com
# ---------------------------------------------------------------------------
STREAMGUARD_ADDR=http://streamguard.localhost
GRAFANA_ADDR=http://grafana.localhost
GRAFANA_URL=http://grafana.localhost
